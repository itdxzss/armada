+func TestLoginPreparationFailurePreservesDeletionBlock(t *testing.T) {
+	err := fmt.Errorf("create account: %w", app.ErrAccountDeletionBlocked)
+	got := loginPreparationFailure(err)
+	if got.Code != vo.AccountDeletionBlockedCode {
