# Armada staging deployment env.
# Copy this file to /home/app/armada-deploy/.env on the test server and fill real values there.
# deploy-test.sh syncs this example but never overwrites the real .env.

ARMADA_HTTP_PORT=18080
APP_TITLE=第一套环境

DB_URL=jdbc:mysql://REPLACE_RDS_ENDPOINT:3306/armada?useSSL=false&serverTimezone=UTC
DB_USER=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD

DEV_LOGIN_PASSWORD=armada123
JAVA_TOOL_OPTIONS=-Xms1024m -Xmx1024m

# HTTP protocol-layer integration. This must point to the protocol master gateway,
# not a standalone worker. The test master currently runs on 65.2.122.109:8080.
ARMADA_PROTOCOL_BASE_URL=http://65.2.122.109:8080
PROTOCOL_ANDROID_BASE_URL=http://localhost:8000
ARMADA_PROTOCOL_API_KEY=
ARMADA_PROTOCOL_RESTART_MASTER_READY_URL=http://65.2.122.109:8080/readyz
ARMADA_PROTOCOL_RESTART_WORKER_1_READY_URL=http://65.2.122.109:8081/readyz
ARMADA_PROTOCOL_RESTART_WORKER_2_READY_URL=http://65.2.122.109:8082/readyz
ARMADA_PROTOCOL_RESTART_WORKER_3_READY_URL=http://65.2.122.109:8083/readyz
ARMADA_PROTOCOL_RESTART_WORKER_4_READY_URL=http://65.2.122.109:8084/readyz

# Shared Redis used by Armada image writes and Android Zhuan image reads.
ANDROID_IMAGE_REDIS_MODE=standalone
ANDROID_IMAGE_REDIS_ADDRESSES=REPLACE_SHARED_REDIS_ENDPOINT:6379
ANDROID_IMAGE_REDIS_USERNAME=
ANDROID_IMAGE_REDIS_PASSWORD=
ANDROID_IMAGE_REDIS_DATABASE=0
ANDROID_IMAGE_REDIS_TLS=false
ANDROID_IMAGE_REDIS_KEY_PREFIX=android-zhuan:

# Isolate login sessions when environments share the same Redis cluster.
AUTH_SESSION_KEY_PREFIX=armada:test1:

# Promotion platform Access Token encryption. Generate the key once with
# `openssl rand -base64 32`, keep it stable per environment, and never commit the real value.
# Increment the key ID whenever the key changes; retain old key material according to the rotation plan.
PROMOTION_TRACKING_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
PROMOTION_TRACKING_ENCRYPTION_KEY_ID=env-v1

# Facebook CAPI probe sends a real test event; enable it only in controlled environments.
ARMADA_PROMOTION_TRACKING_FACEBOOK_PROBE_ENABLED=false

# Kafka consume + command dispatch.
SPRING_PROFILES_ACTIVE=kafka
SPRING_TASK_SCHEDULING_POOL_SIZE=4
KAFKA_BOOTSTRAP_SERVERS=REPLACE_KAFKA_BROKERS
SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SSL
PROTOCOL_ACCOUNT_COMMANDS_TOPIC=protocol.account.commands.v1
PROTOCOL_MASTER_COMMANDS_TOPIC=protocol.master.commands.v1
PROTOCOL_ANDROID_LIFECYCLE_COMMANDS_TOPIC=protocol.android.lifecycle.commands.v1
PROTOCOL_ANDROID_MESSAGE_COMMANDS_TOPIC=protocol.android.message.commands.v1
PROTOCOL_ANDROID_GROUP_JOIN_COMMANDS_TOPIC=protocol.android.group-join.commands.v1
PROTOCOL_ACCOUNT_EVENTS_TOPIC=protocol.account.events.v1
PROTOCOL_MESSAGE_EVENTS_TOPIC=protocol.message.events.v1
PROTOCOL_GROUP_EVENTS_TOPIC=protocol.group.events.v1
PROTOCOL_ACCOUNT_EVENTS_GROUP_ID=armada-api-account-events
PROTOCOL_MESSAGE_EVENTS_GROUP_ID=armada-api-message-events
PROTOCOL_GROUP_EVENTS_GROUP_ID=armada-api-group-events
PROTOCOL_COMMAND_DISPATCH_IMMEDIATE_ENABLED=true
PROTOCOL_COMMAND_DISPATCH_SCHEDULER_ENABLED=true
ACCOUNT_IMPORT_ONLINE_DISPATCH_SCHEDULER_ENABLED=true
IP_PROXY_UNAVAILABLE_RECHECK_BATCH_SIZE=20
ARMADA_IP_PROXY_UNAVAILABLE_RECHECK_BATCH_SIZE=20
