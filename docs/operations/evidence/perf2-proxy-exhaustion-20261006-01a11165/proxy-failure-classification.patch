+// loginPreparationFailure 区分注销生命周期拦截与系统故障，避免被当作代理失败自动重试。
+func loginPreparationFailure(err error) vo.Resp {
+	if errors.Is(err, app.ErrAccountDeletionBlocked) {
+		return vo.Resp{Code: vo.AccountDeletionBlockedCode, Msg: "account deletion blocks login"}
+	}
+	return vo.IncompleteSys(err.Error())
+}
+
 // finishLoginStart 是同步/异步行为的唯一分叉点。把分叉限制在 Promise 等待处，
 // 可以防止后续维护时两套登录准备逻辑逐渐产生差异。
 func finishLoginStart(loginPromise _interface.IPromise, wait bool) vo.Resp {
